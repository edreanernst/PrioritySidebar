<Window x:Class="PrioritySidebar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PrioritySidebar"
        Title="Priority Sidebar"
        Width="320" Height="700"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1,0,0,0"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#59808080" CornerRadius="3"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AddBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small icon button on a card, with an optional count beside the icon. -->
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Height" Value="24"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14">
                  <Canvas Width="24" Height="24">
                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Canvas>
                </Viewbox>
                <ContentPresenter x:Name="Count" Margin="4,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Count" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#38808080"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#38808080"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource DescBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,4">
              <TextBlock x:Name="Text" Text="{TemplateBinding Content}" TextDecorations="Underline"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Text" Property="TextDecorations" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CheckRow" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                      BorderBrush="{StaticResource SubBrush}" Background="Transparent" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path x:Name="Tick" Data="M2.5,6.5 L5.5,9.5 L10.5,3.5" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="8,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChecklistProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="{StaticResource RuleBrush}" CornerRadius="1.5"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5"
                      HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:CardViewModel}">
      <Grid Margin="0,3">
        <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1.5" CornerRadius="8" Padding="6,10,12,10" Cursor="Hand"
                PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseMove="Card_PreviewMouseMove"
                MouseLeftButtonUp="Card_MouseLeftButtonUp">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="22"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Rank}" Foreground="{StaticResource SubBrush}" FontSize="13" FontWeight="SemiBold"
                       TextAlignment="Right" Margin="0,1,0,0"/>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" LineHeight="19"/>

              <!-- Labels, then buttons that show the description and the checklist. -->
              <WrapPanel Margin="-4,2,0,-3" Visibility="{Binding ShowMeta, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Labels}" Margin="4,0,0,0" Focusable="False" VerticalAlignment="Center"
                              Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SubBrush}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="DescChip" Style="{StaticResource ChipButton}" Tag="{StaticResource IconDescription}"
                        ToolTip="Description" AutomationProperties.Name="Description" Click="DescChip_Click"
                        Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"/>
                <Button x:Name="ListChip" Style="{StaticResource ChipButton}" Tag="{StaticResource IconChecklist}"
                        Content="{Binding CheckCountText}" ToolTip="Checklist"
                        AutomationProperties.Name="{Binding ChecklistLabel}" Click="ListChip_Click"
                        Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVisibility}}"/>
              </WrapPanel>

              <ProgressBar x:Name="Progress" Style="{StaticResource ChecklistProgress}" Margin="0,6,0,0"
                           Maximum="{Binding CheckTotal}" Value="{Binding CheckDone, Mode=OneWay}"
                           Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVisibility}}"/>

              <!-- Clicking these doesn't fold the card; see Card_MouseLeftButtonUp. -->
              <StackPanel x:Name="Details">
                <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0"
                        Visibility="{Binding ShowDescription, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <Border x:Name="DescClip" MaxHeight="144" ClipToBounds="True" SizeChanged="DescClip_SizeChanged">
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" LineHeight="18"
                                 LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource DescBrush}"/>
                    </Border>
                    <Button x:Name="MoreLink" Style="{StaticResource LinkButton}" Content="More in Trello" Margin="0,4,0,0"
                            Click="Open_Click" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,4,0,0"
                        Visibility="{Binding ShowChecklist, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <TextBlock Text="{Binding ChecklistStatus}" FontSize="13" Margin="0,4" TextWrapping="Wrap"
                               Foreground="{StaticResource SubBrush}"
                               Visibility="{Binding HasChecklistStatus, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding ChecklistRows}" Focusable="False">
                      <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type local:ChecklistHeading}">
                          <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SubBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{StaticResource SubBrush}"/>
                          </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:CheckItemViewModel}">
                          <CheckBox Style="{StaticResource CheckRow}" IsChecked="{Binding IsDone}" Click="CheckItem_Click"
                                    AutomationProperties.Name="{Binding Name}">
                            <TextBlock x:Name="ItemText" Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" LineHeight="18"
                                       LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource DescBrush}"/>
                          </CheckBox>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                              <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource SubBrush}"/>
                              <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.Resources>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
            <Border x:Name="Tools" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-6,-8,0" Padding="2" CornerRadius="7" Background="{StaticResource CardBrush}" Visibility="Hidden">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconUp}" ToolTip="Move up"
                        AutomationProperties.Name="Move up" IsEnabled="{Binding CanMoveUp}" Click="MoveUp_Click"/>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconDown}" ToolTip="Move down"
                        AutomationProperties.Name="Move down" IsEnabled="{Binding CanMoveDown}" Click="MoveDown_Click"/>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconOpen}" ToolTip="Open in Trello"
                        AutomationProperties.Name="Open in Trello" Click="Open_Click"/>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconDone}" ToolTip="Done (archive)"
                        AutomationProperties.Name="Done, archive this card" Click="Done_Click"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Setter TargetName="Tools" Property="Visibility" Value="Visible"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsDragging}" Value="True">
          <Setter TargetName="Card" Property="Opacity" Value="0.35"/>
          <Setter TargetName="Tools" Property="Visibility" Value="Hidden"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowDescription}" Value="True">
          <Setter TargetName="DescChip" Property="Foreground" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="DescChip" Property="Background" Value="#2E808080"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding ShowChecklist}" Value="True">
          <Setter TargetName="ListChip" Property="Foreground" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="ListChip" Property="Background" Value="#2E808080"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding CheckComplete}" Value="True">
          <Setter TargetName="ListChip" Property="Foreground" Value="{StaticResource OkBrush}"/>
          <Setter TargetName="Progress" Property="Foreground" Value="{StaticResource OkBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding DescriptionClipped}" Value="True">
          <Setter TargetName="DescClip" Property="OpacityMask">
            <Setter.Value>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="Black" Offset="0.72"/>
                <GradientStop Color="Transparent" Offset="1"/>
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
          <Setter TargetName="MoreLink" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="16,14,10,12" Background="Transparent">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Settings" Click="Settings_Click"/>
          <MenuItem Header="Check Trello now" Click="Refresh_Click"/>
          <Separator/>
          <MenuItem Header="Close Priority Sidebar" Click="Quit_Click"/>
        </ContextMenu>
      </Border.ContextMenu>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ListTitle" Text="Priorities" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource SubBrush}" Margin="0,2,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="34" Height="34" Tag="{StaticResource IconRefresh}"
                ToolTip="Check Trello for changes" AutomationProperties.Name="Check Trello for changes" Click="Refresh_Click"/>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34" Tag="{StaticResource IconSettings}"
                ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"/>
      </Grid>
    </Border>

    <!-- Add a card -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,10,10,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="AddBox" Style="{StaticResource AddBox}" Height="36" KeyDown="AddBox_KeyDown"
                 AutomationProperties.Name="Add a card"/>
        <TextBlock Text="Add a card" Foreground="{StaticResource SubBrush}" Margin="13,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" x:Name="AddPlaceholder"/>
        <Button Grid.Column="1" Margin="6,0,0,0" Width="36" Height="36" Style="{StaticResource IconButton}"
                Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                Tag="{StaticResource IconAdd}" ToolTip="Add card" AutomationProperties.Name="Add card" Click="Add_Click"/>
      </Grid>
    </Border>

    <!-- Message with optional Undo -->
    <Border x:Name="Toast" DockPanel.Dock="Bottom" Margin="10,0,10,8" Padding="12,8,8,8" CornerRadius="8"
            Background="{StaticResource ToastBrush}" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ToastText" Foreground="{StaticResource ToastTextBrush}" FontSize="13" TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button x:Name="UndoButton" Grid.Column="1" Content="Undo" Click="Undo_Click" Margin="8,0,0,0" Cursor="Hand"
                Foreground="{StaticResource ToastTextBrush}" FontWeight="SemiBold" FontSize="13">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" Padding="6,4">
                <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Border>

    <!-- Cards -->
    <Grid x:Name="ListHost" AllowDrop="True" Background="Transparent"
          DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop">
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="10,8,6,8" Focusable="False">
        <ItemsControl x:Name="CardList" ItemTemplate="{StaticResource CardTemplate}" Focusable="False"/>
      </ScrollViewer>

      <Border x:Name="DropLine" Height="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
              VerticalAlignment="Top" Margin="12,0,10,0" IsHitTestVisible="False" Visibility="Collapsed"/>

      <StackPanel x:Name="SetupPanel" VerticalAlignment="Center" Margin="24,0" Visibility="Collapsed">
        <TextBlock Text="Connect to Trello to see your list." TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource SubBrush}"/>
        <Button Content="Open settings" Click="Settings_Click" Margin="0,14,0,0" HorizontalAlignment="Center"
                Padding="16,8" Cursor="Hand" Foreground="{StaticResource OnAccentBrush}" FontWeight="SemiBold">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>

      <TextBlock x:Name="EmptyText" Text="No cards in this list yet. Add one below." TextWrapping="Wrap"
                 TextAlignment="Center" VerticalAlignment="Center" Margin="24,0" Foreground="{StaticResource SubBrush}"
                 Visibility="Collapsed"/>
    </Grid>
  </DockPanel>
</Window>
