<Application x:Class="PrioritySidebar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#1B1C1F"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="#2A2C30"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2E3035"/>
    <SolidColorBrush x:Key="CardBrush" Color="#26282C"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#303338"/>
    <SolidColorBrush x:Key="TextBrush" Color="#ECECEE"/>
    <SolidColorBrush x:Key="SubBrush" Color="#A6A9B0"/>
    <SolidColorBrush x:Key="InputBrush" Color="#222428"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E8B04B"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#17181B"/>
    <SolidColorBrush x:Key="ToastBrush" Color="#ECECEE"/>
    <SolidColorBrush x:Key="ToastTextBrush" Color="#1B1C1F"/>

    <!-- Icons drawn on a 24 x 24 grid. -->
    <Geometry x:Key="IconUp">M6,15 L12,9 L18,15</Geometry>
    <Geometry x:Key="IconDown">M6,9 L12,15 L18,9</Geometry>
    <Geometry x:Key="IconOpen">M14,4 H20 V10 M20,4 L11,13 M18,14 V19 A1,1 0 0 1 17,20 H5 A1,1 0 0 1 4,19 V7 A1,1 0 0 1 5,6 H10</Geometry>
    <Geometry x:Key="IconDone">M5,12.5 L9.5,17 L19,7.5</Geometry>
    <Geometry x:Key="IconRefresh">M20,11 A8,8 0 1 0 17.7,16.7 M20,4 V11 H13</Geometry>
    <Geometry x:Key="IconAdd">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="IconSettings">M4,7 H11 M15,7 H20 M13,5 V9 M4,17 H7 M11,17 H20 M9,15 V19</Geometry>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                        Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#38808080"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#38808080"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Application.Resources>
</Application>
